# Ignore ALL node_modules folders (any depth)
**/node_modules/

# Ignore SQLite DB files anywhere (example: *.sqlite, or specifically what you use)
**/*.sqlite
**/*.db

# Ignore environment files (just in case)
**/.env

# Ignore macOS system files
.DS_Store

# Ignore build/output folders (optional, if you're building somewhere)
**/dist/
**/build/

# Logs
**/*.log
